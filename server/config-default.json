{
  "domains": ["forsaken-mail.local"],
  "keywordBlacklist": [
    "admin",
    "postmaster",
    "system",
    "webmaster",
    "administrator",
    "hostmaster",
    "service",
    "server",
    "root"
  ],
  "http": {
    "host": "0.0.0.0",
    "port": 3000
  },
  "smtp": {
    "host": "0.0.0.0",
    "port": 25,
    "sizeLimit": 10485760
  },
  "ingest": {
    "token": null
  },
  "retention": {
    "messageTtlHours": 24,
    "maxMessagesPerAccount": 100,
    "maxTotalMessages": 20000
  }
}
